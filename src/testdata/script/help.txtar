# Help text, exit codes and flag handling. No router call happens here.

# The flag defaults in the help come from the environment; clear it so the
# golden file matches.
env GLINET_URL=
env GLINET_USER=

# No command: help on stderr, exit 2.
exits 2 glinet-cli
! stdout .
cmp stderr usage.txt

# Asked-for help goes to stdout and exits 0.
exec glinet-cli -h
cmp stdout usage.txt
! stderr .
exec glinet-cli -help
cmp stdout usage.txt
exec glinet-cli help
cmp stdout usage.txt
exec glinet-cli help -h
cmp stdout usage.txt

# Command help: its forms and only its own flags.
exec glinet-cli vpn -h
cmp stdout vpn_usage.txt
! stderr .
exec glinet-cli vpn on -all -help
cmp stdout vpn_usage.txt
exec glinet-cli help vpn
cmp stdout vpn_usage.txt
exec glinet-cli help web
cmp stdout web_usage.txt
exits 2 glinet-cli help reboot
stderr '^glinet-cli: unknown command "reboot"$'
exits 2 glinet-cli help vpn on
stderr '^glinet-cli: help takes at most one command$'

# A command's flags stay out of the top-level help.
exits 2 glinet-cli vpn -bogus
cmp stderr vpn_bogus.txt

# Usage errors: the cause, then the help, exit 2. TestParseCommandLine
# covers which arguments each command takes.
exits 2 glinet-cli reboot
stderr '^glinet-cli: unknown command "reboot"$'
stderr '^Usage: glinet-cli \[flags\] <command>$'
exits 2 glinet-cli vpn on
stderr '^glinet-cli: expected one tunnel ID or name, or -all$'

# Flag errors.
exits 2 glinet-cli -timeout 0 status
stderr '^glinet-cli: -timeout must be positive$'
exits 2 glinet-cli -bogus
stderr '^glinet-cli: flag provided but not defined: -bogus$'

# Global flags also work after the command and its operands.
exits 2 glinet-cli status -timeout 0
stderr '^glinet-cli: -timeout must be positive$'
exits 2 glinet-cli vpn on -all -bogus
stderr '^glinet-cli: flag provided but not defined: -bogus$'

# Version.
exec glinet-cli -version
stdout '^glinet-cli dev$'
! stderr .
exec glinet-cli vpn -version
stdout '^glinet-cli dev$'

-- usage.txt --
Usage: glinet-cli [flags] <command>

Commands:
  auth [login]                          check password and save it in the OS keychain
  auth logout                           remove the saved password
  status [-json]                        show router overview
  vpn [status]                          list VPN tunnels
  vpn on <id|name> | -all [-wait]       turn VPN tunnel(s) on (-wait: until connected)
  vpn off <id|name> | -all              turn VPN tunnel(s) off
  vpn restart <id|name> | -all [-wait]  restart VPN tunnel(s), off then on (-wait: until connected)
  web                                   open the router web interface in browser

Environment:
  GLINET_PASSWORD  router password; overrides the saved one

Flags:
  -timeout duration
    	timeout for router requests (default 30s)
  -url string
    	router URL (env GLINET_URL) (default "http://192.168.8.1")
  -user string
    	router username (env GLINET_USER) (default "root")
  -version
    	print version and exit

Run "glinet-cli help <command>" for command details.
-- vpn_usage.txt --
Usage:
  glinet-cli vpn [status]                          list VPN tunnels
  glinet-cli vpn on <id|name> | -all [-wait]       turn VPN tunnel(s) on (-wait: until connected)
  glinet-cli vpn off <id|name> | -all              turn VPN tunnel(s) off
  glinet-cli vpn restart <id|name> | -all [-wait]  restart VPN tunnel(s), off then on (-wait: until connected)

Flags:
  -all
    	target every tunnel
  -wait
    	after on or restart, wait until the tunnel is connected
-- web_usage.txt --
Usage:
  glinet-cli web  open the router web interface in browser
-- vpn_bogus.txt --
glinet-cli: flag provided but not defined: -bogus
Usage: glinet-cli [flags] <command>

Commands:
  auth [login]                          check password and save it in the OS keychain
  auth logout                           remove the saved password
  status [-json]                        show router overview
  vpn [status]                          list VPN tunnels
  vpn on <id|name> | -all [-wait]       turn VPN tunnel(s) on (-wait: until connected)
  vpn off <id|name> | -all              turn VPN tunnel(s) off
  vpn restart <id|name> | -all [-wait]  restart VPN tunnel(s), off then on (-wait: until connected)
  web                                   open the router web interface in browser

Environment:
  GLINET_PASSWORD  router password; overrides the saved one

Flags:
  -timeout duration
    	timeout for router requests (default 30s)
  -url string
    	router URL (env GLINET_URL) (default "http://192.168.8.1")
  -user string
    	router username (env GLINET_USER) (default "root")
  -version
    	print version and exit

Run "glinet-cli help <command>" for command details.
