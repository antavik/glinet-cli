# status: the three optional calls fail. Each degrades its own part, stderr
# says why, and the exit code stays 0.

exec glinet-cli status
cmp stdout want.txt
cmp stderr warnings.txt

exec glinet-cli status -json
stdout '"update": null,\n    "error": "upgrade\.check_firmware_online: Internal error \(code -32603\)"'
stdout '"cable": null,\n    "error": "cable\.get_status: Internal error \(code -32603\)"'
stdout '"tunnels": null,\n    "error": "vpn-client\.get_status: Internal error \(code -32603\)"'
cmp stderr warnings.txt

-- want.txt --
Router    GL-MT3000-49a  mt3000  94:83:C4:0C:74:9A
Firmware  4.9.0 (update check failed)
Uptime    1d 1h 1m
Load      0.12 0.34 0.56
Memory    39%  198 MiB / 512 MiB
Flash     12%  15 MiB / 128 MiB
WAN       online via cable
VPN       unknown
-- warnings.txt --
glinet-cli: warning: upgrade.check_firmware_online: Internal error (code -32603)
glinet-cli: warning: cable.get_status: Internal error (code -32603)
glinet-cli: warning: vpn-client.get_status: Internal error (code -32603)
-- handlers.json --
{"fail":["upgrade.check_firmware_online","cable.get_status","vpn-client.get_status"]}
