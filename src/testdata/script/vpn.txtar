# vpn: list, on, off and restart against a fake router that keeps state.

# List.
exec glinet-cli vpn
cmp stdout list.txt
! stderr .
exec glinet-cli vpn status
cmp stdout list.txt

# Off by name, any case; the next list shows it.
exec glinet-cli vpn off home/wg
cmp stdout off-home.txt
exec glinet-cli vpn
stdout '^2001  Home/WG    off      -$'

# Target "all" is a name now: no tunnel matches it.
exits 1 glinet-cli vpn on all
! stdout .
stderr '^glinet-cli: no VPN tunnel matches "all"$'

# Bad combinations are usage errors before any router call.
exits 2 glinet-cli vpn on -all 2001
stderr '^glinet-cli: '
exits 2 glinet-cli vpn on -bogus
stderr '^glinet-cli: flag provided but not defined: -bogus$'

# -all turns on only what is off.
exec glinet-cli vpn on -all
cmp stdout on-all.txt

# Restart -all.
exec glinet-cli vpn restart -all
cmp stdout restart-all.txt
exec glinet-cli vpn
cmp stdout list-all-on.txt

# Restart by ID.
exec glinet-cli vpn restart 2003
stdout '^Travel/WG: restarted$'
exec glinet-cli vpn
stdout '^2003  Travel/WG  on       connected$'

# -wait returns once the tunnel reports connected.
exec glinet-cli vpn restart 2001 -wait
cmp stdout restart-wait.txt
exits 2 glinet-cli vpn off 2001 -wait
stderr '^glinet-cli: -wait works with on and restart only$'

# Unknown target: exit 1, prefixed message on stderr, nothing on stdout.
exits 1 glinet-cli vpn off nope
! stdout .
stderr '^glinet-cli: no VPN tunnel matches "nope"$'

-- list.txt --
ID    NAME       ENABLED  STATUS
2001  Home/WG    on       connected
2002  Work/OVPN  off      -
2003  Travel/WG  on       connecting
-- list-all-on.txt --
ID    NAME       ENABLED  STATUS
2001  Home/WG    on       connected
2002  Work/OVPN  on       connected
2003  Travel/WG  on       connected
-- off-home.txt --
Home/WG: off
-- on-all.txt --
Home/WG: on
Work/OVPN: on
Travel/WG: already on
-- restart-all.txt --
Home/WG: restarted
Work/OVPN: restarted
Travel/WG: restarted
-- restart-wait.txt --
Home/WG: restarted
Home/WG: connected
